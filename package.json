{
  "name": "codexsample1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:unit",
    "test:unit": "jest",
    "test:unit:coverage": "jest --coverage",
    "test:unit:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "start:e2e": "next start -p 3000",
    "analyze:bundle": "ANALYZE=true next build",
    "analyze:lighthouse": "node scripts/analyze-lighthouse.mjs",
    "serve:lighthouse": "next start -p 3000",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.16",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.3",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.0.11",
    "lint-staged": "15.2.2",
    "postcss": "8.4.31",
    "prettier": "3.2.5",
    "tailwindcss": "3.4.1",
    "prettier-plugin-tailwindcss": "0.5.11",
    "@netlify/plugin-nextjs": "5.3.3",
    "@next/bundle-analyzer": "14.2.3",
    "@playwright/test": "1.45.1",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "14.2.1",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lighthouse": "12.0.0",
    "wait-on": "7.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
